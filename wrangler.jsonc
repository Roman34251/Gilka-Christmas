{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gilka-christmas",
  "main": "dist/worker.js",
  "compatibility_date": "2026-11-08",
  "workers_dev": true,
  "assets": {
    "directory": "./dist/assets",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/api/*",
      "/catalog",
      "/catalog/*",
      "/product/*",
      "/cart",
      "/checkout",
      "/order",
      "/delivery",
      "/returns",
      "/privacy",
      "/contacts",
      "/robots.txt",
      "/sitemap.xml",
    ],
    "html_handling": "none",
    "not_found_handling": "none",
  },
  "vars": {
    "SANITY_PROJECT_ID": "fcl0yp5j",
    "SANITY_DATASET": "production",
  },
}
